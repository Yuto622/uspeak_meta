# ---- Server (server/.env or Fly secrets) ----
# Port the HTTP + WebSocket server listens on. Fly.io sets this via fly.toml.
PORT=2567
NODE_ENV=development

# Maximum players per room (1 room = 1 class). Default 30. Tested up to 100 in one room.
# Several classes (rooms) can run at once on one server; the total is not capped here.
MAX_CLIENTS=30

# Shared secret typed by the teacher in the lobby. Never ship this in the client.
# Leave empty to disable the teacher role entirely.
TEACHER_KEY=change-me-teacher-key

# Comma-separated list of allowed browser origins for CORS / WebSocket.
# In production you MUST set this (e.g. https://uspeak-multiplayer.fly.dev).
# Use * only for local development.
CORS_ORIGINS=http://localhost:2567,http://127.0.0.1:2567

# Serve client/dist from the same server (true/false). Default true.
SERVE_CLIENT=true

# Broadcast rate. 100 ms = 10 Hz.
PATCH_RATE_MS=100
# Seconds a disconnected player keeps their seat (iPad background/lock).
RECONNECT_GRACE_SEC=60

# ---- AI partner for the errand quest (おつかいクエスト) ----
# Read on the server only; never sent to the browser. Leave OPENAI_API_KEY empty to run
# the scripted partner instead: the quest still works, with fixed replies and no API cost.
OPENAI_API_KEY=
# Set this to the model you want to use. Check current model names and pricing with your
# provider before a class relies on it.
OPENAI_MODEL=gpt-4o-mini
# Cost and abuse guards.
AI_MAX_TOKENS=300
AI_TIMEOUT_MS=20000
AI_MIN_INTERVAL_MS=1200
AI_DAILY_TURNS_PER_STUDENT=200

# ---- Persistence ----
# auto = Google Sheets when GOOGLE_SHEET_ID is set, otherwise a local JSON file.
STORE_BACKEND=auto
STORE_FLUSH_MS=5000
DATA_DIR=./data

# Google Sheets (service account). Share the spreadsheet with the service account email.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n for newlines, wrapped in quotes.
GOOGLE_PRIVATE_KEY=""
# Alternative to the two values above: base64 of the whole service-account JSON file.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Client config served at /config.js (only needed when client and server are on different hosts) ----
# PUBLIC_SERVER_URL=wss://uspeak-multiplayer.fly.dev
# Default class code prefilled in the lobby.
# PUBLIC_DEFAULT_CLASS=
# Tune client sync/rendering constants without a code change (keys from client/dist/net-config.js).
# NET_OVERRIDES={"INTERP_DELAY_MS":150,"MAX_RENDERED_REMOTES":24}

# ---- Classroom operations ----
# 入場ゲート. 'open' (default) lets anyone with the class code in. 'roster' admits only
# children on the class register, plus any teacher holding TEACHER_KEY.
#
# The register lives in the store: a `roster` tab (class | name | note) in the Google
# Sheet, or data/roster.json next to the file store:
#   {"classes": {"6-1": ["Aki", "Ben"], "6-2": ["Chika"]}}
#
# It is read once per class and cached, and the last good copy is kept on disk, so a
# Sheets outage mid-lesson does not lock a class out. A child with a record in that
# class from an earlier lesson is admitted even then.
ACCESS_MODE=open
ROSTER_TTL_MS=300000

# 保護者レポート. Signs the per-child report links a teacher hands to families
# (/report/<class>/<name>?t=...). Without it the route is not served at all, because a
# guessable link would show one family another family's child. At least 16 characters;
# generate with:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
REPORT_SECRET=
