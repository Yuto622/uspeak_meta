# ---- Server (server/.env or Fly secrets) ----
# Port the HTTP + WebSocket server listens on. Fly.io sets this via fly.toml.
PORT=2567
NODE_ENV=development

# Maximum players per room (1 room = 1 class). Default 30.
MAX_CLIENTS=30

# Shared secret typed by the teacher in the lobby. Never ship this in the client.
# Leave empty to disable the teacher role entirely.
TEACHER_KEY=change-me-teacher-key

# Comma-separated list of allowed browser origins for CORS / WebSocket.
# In production you MUST set this (e.g. https://uspeak-multiplayer.fly.dev).
# Use * only for local development.
CORS_ORIGINS=http://localhost:2567,http://127.0.0.1:2567

# Serve client/dist from the same server (true/false). Default true.
SERVE_CLIENT=true

# Broadcast rate. 100 ms = 10 Hz.
PATCH_RATE_MS=100
# Seconds a disconnected player keeps their seat (iPad background/lock).
RECONNECT_GRACE_SEC=60

# ---- Persistence ----
# auto = Google Sheets when GOOGLE_SHEET_ID is set, otherwise a local JSON file.
STORE_BACKEND=auto
STORE_FLUSH_MS=5000
DATA_DIR=./data

# Google Sheets (service account). Share the spreadsheet with the service account email.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n for newlines, wrapped in quotes.
GOOGLE_PRIVATE_KEY=""
# Alternative to the two values above: base64 of the whole service-account JSON file.
GOOGLE_SERVICE_ACCOUNT_JSON=

# ---- Client config served at /config.js (only needed when client and server are on different hosts) ----
# PUBLIC_SERVER_URL=wss://uspeak-multiplayer.fly.dev
# Default class code prefilled in the lobby.
# PUBLIC_DEFAULT_CLASS=
